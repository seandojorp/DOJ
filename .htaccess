# DOJ-NPS EMS — project root (XAMPP: htdocs/doj-ems)
# Everything is routed into public/. App code, config, storage, database and tests are never served.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|storage|database|tests|tools|vendor)(/|$) - [F,L]
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|.*\.md)$ - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
